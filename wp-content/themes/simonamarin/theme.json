{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "40rem",
			"wideSize": "68rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"palette": [
				{ "slug": "base",          "name": "Fundal",             "color": "#FAF8F5" },
				{ "slug": "surface",       "name": "Card",               "color": "#F0EBE4" },
				{ "slug": "primary-soft",  "name": "Sectiune verde",     "color": "#DCE7E3" },
				{ "slug": "border",        "name": "Linie",              "color": "#DDD5CA" },
				{ "slug": "muted",         "name": "Text secundar",      "color": "#55635F" },
				{ "slug": "contrast",      "name": "Text principal",     "color": "#24302C" },
				{ "slug": "primary",       "name": "Verde principal",    "color": "#3D6F65" },
				{ "slug": "primary-dark",  "name": "Verde inchis",       "color": "#2C524A" },
				{ "slug": "accent",        "name": "Accent caramiziu",   "color": "#95563A" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fluid": true,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "Sistem",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Mic",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Normal",
					"size": "1.125rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Mare",
					"size": "1.375rem",
					"fluid": { "min": "1.25rem", "max": "1.375rem" }
				},
				{
					"slug": "x-large",
					"name": "Foarte mare",
					"size": "1.75rem",
					"fluid": { "min": "1.5rem", "max": "1.75rem" }
				},
				{
					"slug": "xx-large",
					"name": "Titlu de pagina",
					"size": "2.25rem",
					"fluid": { "min": "1.75rem", "max": "2.25rem" }
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"units": [ "px", "rem", "%" ],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"spacingSizes": [
				{ "slug": "20", "name": "Foarte mic", "size": "0.5rem" },
				{ "slug": "30", "name": "Mic",        "size": "1rem" },
				{ "slug": "40", "name": "Normal",     "size": "1.5rem" },
				{ "slug": "50", "name": "Mare",       "size": "2.5rem" },
				{ "slug": "60", "name": "Foarte mare", "size": "4rem" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"borderStrong": "#7C8884"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "1.25rem",
				"right": "1.25rem"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--primary-dark)" },
					"typography": { "textDecoration": "underline" }
				},
				":focus": {
					"color": { "text": "var(--wp--preset--color--primary-dark)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"h4": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"textDecoration": "none"
				},
				"border": { "radius": "0.25rem" },
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/quote": {
				"color": { "background": "var(--wp--preset--color--primary-soft)" },
				"spacing": {
					"padding": {
						"top": "1.5rem",
						"bottom": "1.5rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"border": {
					"radius": "0.25rem"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			},
			"core/table": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/pullquote": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" },
				"color": { "text": "var(--wp--preset--color--primary-dark)" }
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--surface)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		}
	}
}
